{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "env": [
    {
      "key": "NEXT_PUBLIC_APP_NAME",
      "value": "FlyRank"
    },
    {
      "key": "NEXT_PUBLIC_APP_URL",
      "value": "@vercel-url"
    },
    {
      "key": "NEXT_PUBLIC_API_URL",
      "value": "@vercel-url/api"
    }
  ]
}
